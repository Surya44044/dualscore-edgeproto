name: Auto Build DockerHub and Deploy Azure

on:
  push:
    branches: [ main ]
  workflow_dispatch:

concurrency:
  group: azure-containerapp-deploy-main
  cancel-in-progress: true

jobs:
  build-push-deploy:
    name: Build Docker Image, Push to DockerHub, Deploy to Azure
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Verify API Code
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements-api.txt
          python -m compileall -q src
          bash scripts/check_no_secrets.sh
          bash scripts/test_api_local.sh

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to DockerHub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Build and Push Docker Image
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./Dockerfile
          push: true
          tags: |
            docker.io/${{ secrets.DOCKERHUB_USERNAME }}/dualscore-edgeproto:latest
            docker.io/${{ secrets.DOCKERHUB_USERNAME }}/dualscore-edgeproto:${{ github.sha }}

      - name: Log in to Azure
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Ensure Azure Container Apps Extension
        run: |
          az extension add --name containerapp --upgrade || true
          az provider register --namespace Microsoft.App || true
          az provider register --namespace Microsoft.OperationalInsights || true

      - name: Create or Update Azure Container App
        env:
          RG: ${{ secrets.AZURE_RESOURCE_GROUP }}
          APP: ${{ secrets.AZURE_CONTAINER_APP_NAME }}
          ENV_NAME: ${{ secrets.AZURE_CONTAINER_APP_ENV }}
          LOCATION: ${{ secrets.AZURE_LOCATION }}
          DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          set -e

          IMAGE="docker.io/${DOCKERHUB_USERNAME}/dualscore-edgeproto:${IMAGE_TAG}"

          echo "Using image: $IMAGE"
          echo "Resource group: $RG"
          echo "Container app: $APP"
          echo "Environment: $ENV_NAME"
          echo "Location: $LOCATION"

          echo "Ensuring resource group exists..."
          az group create \
            --name "$RG" \
            --location "$LOCATION"

          echo "Ensuring Container Apps environment exists..."
          if ! az containerapp env show --name "$ENV_NAME" --resource-group "$RG" >/dev/null 2>&1; then
            az containerapp env create \
              --name "$ENV_NAME" \
              --resource-group "$RG" \
              --location "$LOCATION"
          fi

          echo "Checking if Container App exists..."
          if az containerapp show --name "$APP" --resource-group "$RG" >/dev/null 2>&1; then
            echo "Container App exists. Updating image..."
            az containerapp update \
              --name "$APP" \
              --resource-group "$RG" \
              --image "$IMAGE"
          else
            echo "Container App does not exist. Creating..."
            az containerapp create \
              --name "$APP" \
              --resource-group "$RG" \
              --environment "$ENV_NAME" \
              --image "$IMAGE" \
              --target-port 8000 \
              --ingress external \
              --cpu 0.25 \
              --memory 0.5Gi \
              --min-replicas 1 \
              --max-replicas 1
          fi

          echo "Ensuring ingress is external on port 8000..."
          az containerapp ingress enable \
            --name "$APP" \
            --resource-group "$RG" \
            --type external \
            --target-port 8000 || true

          echo "Routing all traffic to latest revision..."
          az containerapp ingress traffic set \
            --name "$APP" \
            --resource-group "$RG" \
            --revision-weight latest=100 || true

          echo "Ensuring one running replica for deployment verification..."
          az containerapp update \
            --name "$APP" \
            --resource-group "$RG" \
            --min-replicas 1 \
            --max-replicas 1 || true

          echo "Container app summary:"
          az containerapp show \
            --name "$APP" \
            --resource-group "$RG" \
            --query "{fqdn:properties.configuration.ingress.fqdn, provisioningState:properties.provisioningState, latestRevision:properties.latestRevisionName}" \
            -o table

      - name: Verify Azure Endpoints
        env:
          RG: ${{ secrets.AZURE_RESOURCE_GROUP }}
          APP: ${{ secrets.AZURE_CONTAINER_APP_NAME }}
        run: |
          set -e

          FQDN=$(az containerapp show \
            --name "$APP" \
            --resource-group "$RG" \
            --query "properties.configuration.ingress.fqdn" \
            -o tsv)

          BASE_URL="https://${FQDN}"

          echo "Container App URL: $BASE_URL"
          echo "Waiting for Azure revision to warm up..."
          sleep 120

          for i in {1..15}; do
            echo "Health check attempt $i..."

            HEALTH_CODE=$(curl -L -s -o /tmp/health_body.txt -w "%{http_code}" "$BASE_URL/health" || true)
            echo "Health status code: $HEALTH_CODE"
            cat /tmp/health_body.txt || true
            echo ""

            if [ "$HEALTH_CODE" = "200" ]; then
              echo "[SUCCESS] /health endpoint passed."
              exit 0
            fi

            META_CODE=$(curl -L -s -o /tmp/meta_body.txt -w "%{http_code}" "$BASE_URL/metadata" || true)
            echo "Metadata status code: $META_CODE"
            cat /tmp/meta_body.txt || true
            echo ""

            if [ "$META_CODE" = "200" ]; then
              echo "[SUCCESS] /metadata endpoint passed."
              exit 0
            fi

            ROOT_CODE=$(curl -L -s -o /tmp/root_body.txt -w "%{http_code}" "$BASE_URL/" || true)
            echo "Root status code: $ROOT_CODE"
            head -c 500 /tmp/root_body.txt || true
            echo ""

            sleep 20
          done

          echo "[ERROR] Azure endpoint verification failed after retries."
          exit 1
