name: Azure Container Apps Deploy

on:
  workflow_dispatch:
    inputs:
      image_tag:
        description: "Docker image tag to deploy, e.g. latest or commit SHA"
        required: true
        default: "latest"

jobs:
  azure-deploy:
    name: Deploy DockerHub Image to Azure Container Apps
    runs-on: ubuntu-latest

    steps:
      - name: Log in to Azure
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Deploy / Update Azure Container App
        uses: azure/container-apps-deploy-action@v1
        with:
          resourceGroup: ${{ secrets.AZURE_RESOURCE_GROUP }}
          containerAppName: ${{ secrets.AZURE_CONTAINER_APP_NAME }}
          imageToDeploy: docker.io/${{ secrets.DOCKERHUB_USERNAME }}/dualscore-edgeproto:${{ github.event.inputs.image_tag }}
          targetPort: 8000

      - name: Print Deployment Info
        run: |
          echo "[SUCCESS] Azure Container App update triggered."
          echo "Image tag: ${{ github.event.inputs.image_tag }}"
