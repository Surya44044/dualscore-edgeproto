# Virtual Environment
.venv/
venv/
env/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment and Secrets
.env
*.env
service-principal*.json
azure-credentials*.json
*.pem
*.key
*.pub
dockerhub_token.txt

# Datasets (Strict Rule: Do not commit raw, processed, or split datasets)
data/raw/
data/processed/
data/splits/
*.csv
*.parquet
*.npz
*.npy
!results/tables/*.csv
!examples/*.json

# Model checkpoints (Keep models directory ignored except small committed demo models if any, or keep models/ ignored)
models/*.pt
models/*/*.pt
models/*/*/*.pt
!models/demo_mode.placeholder

# Logs & Temporary Files
logs/*.log
logs/*.txt
!logs/antigravity_backups/
.DS_Store
.idea/
.vscode/
